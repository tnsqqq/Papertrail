{
  "name": "papertrail-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "build:pages": "npm --prefix frontend run build",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build:pages && wrangler pages deploy frontend/dist --project-name=papertrail",
    "deploy": "npm run deploy:worker && npm run deploy:pages"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "pdfjs-dist": "4.8.69"
  },
  "devDependencies": {
    "wrangler": "^4.50.0"
  }
}
