# Document RAG Assistant - Backend Environment Configuration

PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
RAG_STORAGE_DIR=

# Google Gemini (optional; used for answer generation)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# OpenAI (optional; used for embeddings and answer generation)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB is optional; the backend falls back to its local vector index.
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=document_rag_collection
TOP_K=5
